{
  "expo": {
    "name": "Almanac",
    "slug": "almanac",
    "version": "1.0.0",
    "scheme": "almanac",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.iamdegroot.almanac"
    },
    "android": {
      "package": "com.iamdegroot.almanac",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-calendar",
        {
          "calendarPermission": "Almanac reads your calendar to show today's and tomorrow's events."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#E6F4FE",
          "defaultChannel": "daily-brief"
        }
      ],
      "expo-dev-client"
    ]
  }
}
