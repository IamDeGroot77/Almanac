    "build:dev:ios": "eas build --platform ios --profile development",
    "build:preview": "eas build --platform all --profile preview",
    "test": "node scripts/test-sync.mjs && node scripts/test-canvas.mjs && node scripts/test-merge.mjs && node scripts/test-dayauto.mjs && node scripts/test-import.mjs && node scripts/test-lists.mjs && node scripts/test-blocks.mjs && node scripts/test-routines.mjs && node scripts/test-journal.mjs && node scripts/test-scratch.mjs",
    "build:web": "expo export --platform web --output-dir docs/app",
